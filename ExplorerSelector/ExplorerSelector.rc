#include <windows.h>
#include "../Version.h"

IDI_ICON1 ICON DISCARDABLE "app_icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION EXPLORER_SELECTOR_VERSION_MAJOR,EXPLORER_SELECTOR_VERSION_MINOR,EXPLORER_SELECTOR_VERSION_PATCH,EXPLORER_SELECTOR_VERSION_BUILD
PRODUCTVERSION EXPLORER_SELECTOR_VERSION_MAJOR,EXPLORER_SELECTOR_VERSION_MINOR,EXPLORER_SELECTOR_VERSION_PATCH,EXPLORER_SELECTOR_VERSION_BUILD
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Heresy"
            VALUE "FileDescription", "Explorer Selector"
            VALUE "FileVersion", EXPLORER_SELECTOR_VERSION_STRING_4
            VALUE "InternalName", "ExplorerSelector.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "ExplorerSelector.exe"
            VALUE "ProductName", "Explorer Selector"
            VALUE "ProductVersion", EXPLORER_SELECTOR_VERSION_STRING_4
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END